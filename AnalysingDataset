        "import os\n",
        "\n",
        "def count_files(directory, extension):\n",
        "    count = 0\n",
        "    for root, dirs, files in os.walk(directory):\n",
        "        count += sum(1 for f in files if f.endswith(extension))\n",
        "    return count\n",
        "\n",
        "base_path = './extracted_data/shanghaitech_h5_empty/ShanghaiTech/'\n",
        "parts = ['part_A', 'part_B']\n",
        "\n",
        "print(\"Dataset Summary:\")\n",
        "for part in parts:\n",
        "    img_count = count_files(os.path.join(base_path, part), '.jpg')\n",
        "    mat_count = count_files(os.path.join(base_path, part), '.mat')\n",
        "    print(f\"- {part}: {img_count} images, {mat_count} ground truth files\")"
      ],
