        "import scipy.io\n",
        "import matplotlib.pyplot as plt\n",
        "import PIL.Image as Image\n",
        "import numpy as np\n",
        "\n",
        "# Define paths\n",
        "mat_path = './extracted_data/shanghaitech_h5_empty/ShanghaiTech/part_A/train_data/ground-truth/GT_IMG_1.mat'\n",
        "img_path = './extracted_data/shanghaitech_h5_empty/ShanghaiTech/part_A/train_data/images/IMG_1.jpg'\n",
        "\n",
        "# Load mat file\n",
        "mat = scipy.io.loadmat(mat_path)\n",
        "\n",
        "# Inspect 'image_info'\n",
        "# In ShanghaiTech, it's usually: image_info -> location -> [x, y] coordinates\n",
        "# We access the nested structure\n",
        "gt_data = mat['image_info'][0, 0][0, 0][0]\n",
        "\n",
        "print(f\"Number of people in sample image: {len(gt_data)}\")\n",
        "print(f\"First 5 coordinates:\\n{gt_data[:5]}\")\n",
        "\n",
        "# Visualization\n",
        "img = Image.open(img_path)\n",
        "plt.figure(figsize=(10, 8))\n",
        "plt.imshow(img)\n",
        "plt.scatter(gt_data[:, 0], gt_data[:, 1], c='red', s=10, label='Ground Truth')\n",
        "plt.title(f'Sample Image: IMG_1.jpg (Count: {len(gt_data)})')\n",
        "plt.legend()\n",
        "plt.axis('off')\n",
        "plt.show()"
